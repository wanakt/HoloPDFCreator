<Window x:Class="HoloPDFCreator.Dialogs.OcrRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OCR 실행"
        Width="360" SizeToContent="Height"
        Background="{StaticResource BgGradient}"
        Foreground="#CDD6F4"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize"   Value="13"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground"  Value="#CDD6F4"/>
            <Setter Property="FontSize"    Value="13"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="Margin"      Value="0,0,0,6"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CDD6F4"/>
            <Setter Property="FontSize"   Value="13"/>
            <Setter Property="Cursor"     Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background"      Value="{StaticResource GlassSurface}"/>
            <Setter Property="Foreground"      Value="#ECEFFF"/>
            <Setter Property="BorderBrush"     Value="{StaticResource GlassBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontSize"        Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <!-- Section header label -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#89B4FA"/>
            <Setter Property="FontSize"    Value="11"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="Margin"      Value="0,0,0,8"/>
        </Style>
    </Window.Resources>

    <StackPanel Margin="20,18,20,18">

        <!-- ── 범위 ── -->
        <TextBlock Text="범위" Style="{StaticResource SectionHeader}"/>

        <RadioButton x:Name="RadioCurrent" Content="현재 페이지" IsChecked="True"
                     Checked="RadioScope_Checked"/>
        <RadioButton x:Name="RadioAll"     Content="전체 페이지"
                     Checked="RadioScope_Checked"/>
        <RadioButton x:Name="RadioRange"   Content="페이지 범위"
                     Checked="RadioScope_Checked"/>

        <!-- Range inputs (visible only when RadioRange is checked) -->
        <Grid x:Name="RangePanel" Visibility="Collapsed" Margin="18,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="60"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="From" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox   x:Name="TxtFrom" Grid.Column="1" Text="1"
                       PreviewTextInput="NumericOnly"/>
            <TextBlock Grid.Column="2" Text="  to  " VerticalAlignment="Center"/>
            <TextBox   x:Name="TxtTo"   Grid.Column="3" Text="1"
                       PreviewTextInput="NumericOnly"/>
            <TextBlock x:Name="TxtTotalHint" Grid.Column="4"
                       Foreground="#585B70" FontSize="11"
                       VerticalAlignment="Center" Margin="6,0,0,0"/>
        </Grid>

        <!-- ── 모델 ── -->
        <Separator Background="{StaticResource GlassBorder}" Margin="0,8,0,12"/>
        <TextBlock Text="모델" Style="{StaticResource SectionHeader}"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <RadioButton x:Name="RadioMobile" Content="Mobile (빠름)"
                         IsChecked="True" Margin="0,0,16,0"/>
            <RadioButton x:Name="RadioFull"   Content="Full (정확, ~80 MB)"/>
        </StackPanel>

        <!-- ── 설정 ── -->
        <Separator Background="{StaticResource GlassBorder}" Margin="0,8,0,12"/>
        <TextBlock Text="설정" Style="{StaticResource SectionHeader}"/>

        <Grid Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Workers -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Workers:" VerticalAlignment="Center"
                           Foreground="#A6ADC8" Margin="0,0,8,0"/>
                <ComboBox x:Name="CmbWorkers"
                          Background="{StaticResource GlassSurface}" Foreground="#ECEFFF"
                          BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                          Padding="6,4" FontSize="13"
                          Width="65">
                    <ComboBoxItem Content="1"/>
                    <ComboBoxItem Content="2"/>
                    <ComboBoxItem Content="4"/>
                    <ComboBoxItem Content="8"/>
                </ComboBox>
            </StackPanel>

            <!-- Korean upscale -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="한국어 업스케일:" VerticalAlignment="Center"
                           Foreground="#A6ADC8" FontSize="12" Margin="0,0,6,0"
                           ToolTip="한국어 OCR 시 이미지 확대 목표 크기 (px). 낮을수록 빠름, 높을수록 정확."/>
                <TextBox x:Name="TxtKoreanUpscale" Width="52" Text="2560"
                         PreviewTextInput="NumericOnly"
                         ToolTip="권장: 1280(빠름) / 2560(기본) / 3840(정확)"/>
            </StackPanel>
        </Grid>

        <!-- ── Buttons ── -->
        <Separator Background="{StaticResource GlassBorder}" Margin="0,12,0,12"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="1" Content="취소" MinWidth="88"
                    Style="{StaticResource SecondaryButton}" Click="Cancel_Click"/>
            <Button Grid.Column="3" Content="▶ 실행" MinWidth="88"
                    Style="{StaticResource PrimaryButton}" Click="Run_Click"/>
        </Grid>

    </StackPanel>
</Window>
