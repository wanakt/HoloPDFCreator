<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <RootNamespace>HoloPDFCreator</RootNamespace>
    <AssemblyName>HoloPDFCreator</AssemblyName>
  </PropertyGroup>

  <!-- Each page edit allocates document-sized arrays; without this the GC keeps the
       freed large-object-heap space committed (935 MB vs 444 MB after 15 edits of a
       29 MB scan, same speed). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" />
    <PackageReference Include="PDFsharp-WPF" Version="6.1.1" />
    <PackageReference Include="PdfPig" Version="0.1.9" />
    <PackageReference Include="RapidOcrNet" Version="2.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!-- Additional language models (Korean/Chinese v5, Japanese v4).
       Only the version folders: Models\*.cs are source files, not content. -->
  <ItemGroup>
    <Content Include="models\v*\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
