<Window x:Class="HoloPDFCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoloPDF Creator"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E2E">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App Title -->
                <StackPanel DockPanel.Dock="Top" Margin="16,24,16,16">
                    <TextBlock Text="HoloPDF"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#89B4FA"/>
                    <TextBlock Text="Creator"
                               FontSize="22" FontWeight="Bold"
                               Foreground="#CDD6F4"/>
                    <Rectangle Height="1" Fill="#313244" Margin="0,16,0,0"/>
                </StackPanel>

                <!-- NAVIGATION label -->
                <TextBlock DockPanel.Dock="Top"
                           Text="NAVIGATION"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="#585B70"
                           Margin="24,0,16,8"/>

                <!-- Nav Buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnNavPdfReader"
                            Style="{StaticResource NavButtonActive}"
                            Click="BtnNavPdfReader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C4;" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="PDF Reader" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavImageAdjuster"
                            Style="{StaticResource NavButton}"
                            Click="BtnNavImageAdjuster_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F5BC;" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="OCR" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Version at bottom -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0.0"
                           FontSize="11"
                           Foreground="#45475A"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,16"/>

            </DockPanel>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="ContentFrame"
               Grid.Row="0" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="#1E1E2E"/>
    </Grid>
</Window>
