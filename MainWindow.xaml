<Window x:Class="HoloPDFCreator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HoloPDF Creator"
        Height="780" Width="1280"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgGradient}">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ SIDEBAR (frosted glass) ══════════════ -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{StaticResource GlassStrong}"
                BorderBrush="{StaticResource GlassBorder}"
                BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- App Title -->
                <StackPanel DockPanel.Dock="Top" Margin="20,26,16,16">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9"
                                Background="{StaticResource AccentGradient}"
                                Margin="0,0,10,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#89B4FA" BlurRadius="16" ShadowDepth="0" Opacity="0.6"/>
                            </Border.Effect>
                            <TextBlock Text="◈" FontSize="18" Foreground="#15103A"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="HoloPDF"
                                       FontSize="19" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Creator"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentPurple}"
                                       Margin="1,-2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <Rectangle Height="1" Fill="{StaticResource GlassBorder}" Margin="0,18,0,0"/>
                </StackPanel>

                <!-- NAVIGATION label -->
                <TextBlock DockPanel.Dock="Top"
                           Text="NAVIGATION"
                           FontSize="10" FontWeight="SemiBold"
                           Foreground="{StaticResource TextMuted}"
                           Margin="24,4,16,8"/>

                <!-- Nav Buttons -->
                <StackPanel DockPanel.Dock="Top">
                    <Button x:Name="BtnNavPdfReader"
                            Style="{StaticResource NavButtonActive}"
                            Click="BtnNavPdfReader_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F4C4;" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="PDF Reader" FontSize="14"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnNavImageAdjuster"
                            Style="{StaticResource NavButton}"
                            Click="BtnNavImageAdjuster_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x1F5BC;" FontSize="16" Margin="0,0,10,0"/>
                            <TextBlock Text="OCR" FontSize="14"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Version at bottom -->
                <TextBlock DockPanel.Dock="Bottom"
                           Text="v1.0.0"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,16"/>

            </DockPanel>
        </Border>

        <!-- Content Frame -->
        <Frame x:Name="ContentFrame"
               Grid.Row="0" Grid.Column="1"
               NavigationUIVisibility="Hidden"
               Background="Transparent"/>
    </Grid>
</Window>
