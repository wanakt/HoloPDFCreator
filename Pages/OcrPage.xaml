<Page x:Class="HoloPDFCreator.Pages.OcrPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource BgGradient}"
      Title="OCR">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style x:Key="DarkComboBox" TargetType="ComboBox">
            <Setter Property="Background"      Value="#313244"/>
            <Setter Property="Foreground"      Value="#CDD6F4"/>
            <Setter Property="BorderBrush"     Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding"         Value="6,4"/>
            <Setter Property="FontSize"        Value="12"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Focusable="False" ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                                CornerRadius="5" Padding="6,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="16"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="▾" FontSize="9"
                                                           Foreground="#A6ADC8" VerticalAlignment="Center"
                                                           HorizontalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#45475A"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ToggleButton.Background>
                                    <SolidColorBrush Color="#313244"/>
                                </ToggleButton.Background>
                            </ToggleButton>
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="8,0,20,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            <Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True" Focusable="False" PopupAnimation="Slide">
                                <Border Background="{StaticResource GlassMenu}" BorderBrush="{StaticResource GlassBorder}" BorderThickness="1"
                                        CornerRadius="5" MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer>
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#CDD6F4"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding"    Value="8,5"/>
                        <Setter Property="FontSize"   Value="12"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ComboBoxItem">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#45475A"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#313244"/>
                                            <Setter Property="Foreground" Value="#89B4FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ IMAGE LIST PANEL ══════════════ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="{StaticResource GlassHeader}"
                    BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="0,0,1,1"
                    Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtImageCount"
                               Grid.Column="0"
                               Text="0 images"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#89B4FA"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearAll"
                            Grid.Column="1"
                            Content="Clear"
                            Click="ClearAll_Click"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="10"
                            Padding="7,2"
                            Height="22"/>
                </Grid>
            </Border>

            <Border Grid.Row="1" BorderBrush="{StaticResource GlassBorder}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{StaticResource GlassStrong}">
                    <StackPanel x:Name="ImageListPanel" Margin="5,5,5,5"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══════════════ IMAGE VIEWER + OCR TOOLBAR ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Toolbar 1: nav + view toggle + zoom ── -->
            <Border Grid.Row="0"
                    Background="{StaticResource GlassStrong}"
                    BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnPrev"
                                Content="◀"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnPrev_Click"
                                Width="26" Height="22"
                                Padding="0" FontSize="9"
                                IsEnabled="False"/>
                        <TextBlock x:Name="TxtPageNav"
                                   Text="0 / 0"
                                   FontSize="11"
                                   Foreground="#89B4FA"
                                   VerticalAlignment="Center"
                                   Margin="6,0"
                                   MinWidth="42"
                                   TextAlignment="Center"/>
                        <Button x:Name="BtnNext"
                                Content="▶"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnNext_Click"
                                Width="26" Height="22"
                                Padding="0" FontSize="9"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- Zoom -->
                    <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="−"
                                Style="{StaticResource SecondaryButton}"
                                Width="26" Height="22" Padding="0" FontSize="14"
                                Click="BtnZoomOut_Click"/>
                        <TextBlock x:Name="TxtZoom"
                                   Text="100%"
                                   FontSize="11" Foreground="#A6ADC8"
                                   VerticalAlignment="Center"
                                   Margin="5,0" MinWidth="38"
                                   TextAlignment="Center"/>
                        <Button Content="+"
                                Style="{StaticResource SecondaryButton}"
                                Width="26" Height="22" Padding="0" FontSize="14"
                                Click="BtnZoomIn_Click" Margin="0,0,4,0"/>
                        <Button Content="Fit"
                                Style="{StaticResource SecondaryButton}"
                                Height="22" Padding="7,0" FontSize="11"
                                Click="BtnZoomFit_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Toolbar 2: OCR ── -->
            <Border Grid.Row="1"
                    Background="{StaticResource GlassHeader}"
                    BorderBrush="{StaticResource GlassBorder}"
                    BorderThickness="0,0,0,1"
                    Padding="8,5">
                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <TextBlock Text="Language:"
                               FontSize="11" Foreground="#A6ADC8"
                               VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <ComboBox x:Name="CmbLanguage"
                              Style="{StaticResource DarkComboBox}"
                              Width="90" SelectedIndex="0"
                              Margin="0,0,6,0"
                              ToolTip="OCR language">
                        <ComboBoxItem Content="Latin"/>
                        <ComboBoxItem Content="한국어"/>
                        <ComboBoxItem Content="中文"/>
                        <ComboBoxItem Content="日本語"/>
                    </ComboBox>

                    <Separator Background="{StaticResource GlassBorder}" Width="1" Height="20" Margin="2,0,8,0"/>

                    <CheckBox x:Name="ChkDeskew"
                              Content="Deskew"
                              FontSize="11"
                              Foreground="#A6ADC8"
                              VerticalAlignment="Center"
                              IsChecked="True"
                              Margin="0,0,10,0"
                              ToolTip="스캔 이미지의 미세 기울기를 자동으로 보정합니다"/>

                    <Button x:Name="BtnRunOcr"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,4" FontSize="12" Height="26"
                            IsEnabled="False"
                            Click="BtnRunOcr_Click"
                            Margin="0,0,4,0"
                            ToolTip="OCR 실행 설정">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="▶" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Run OCR" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCancelOcr"
                            Content="■ 취소"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,4" FontSize="12" Height="26"
                            Visibility="Collapsed"
                            Click="BtnCancelOcr_Click"
                            Margin="0,0,4,0"/>

                    <ProgressBar x:Name="OcrProgress"
                                 Width="100" Height="6"
                                 Minimum="0" Maximum="100" Value="0"
                                 Visibility="Collapsed"
                                 Foreground="#89B4FA"
                                 Background="{StaticResource GlassSurface}"
                                 BorderThickness="0"
                                 Margin="6,0,0,0"/>

                    <Separator Background="{StaticResource GlassBorder}" Width="1" Height="20" Margin="6,0"/>

                    <Button x:Name="BtnCopyAll"
                            Content="Copy All"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,4" FontSize="12" Height="26"
                            IsEnabled="False"
                            Click="BtnCopyAll_Click"
                            Margin="0,0,4,0"/>

                    <Button x:Name="BtnSaveTxt"
                            Content="Save TXT"
                            Style="{StaticResource SecondaryButton}"
                            Padding="8,4" FontSize="12" Height="26"
                            IsEnabled="False"
                            Click="BtnSaveTxt_Click"
                            Margin="0,0,4,0"/>

                    <Separator Background="{StaticResource GlassBorder}" Width="1" Height="20" Margin="2,0,8,0"/>

                    <Button x:Name="BtnSaveSearchablePdf"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,4" FontSize="12" Height="26"
                            IsEnabled="False"
                            Click="BtnSaveSearchablePdf_Click"
                            ToolTip="OCR 결과를 투명 텍스트 레이어로 삽입한 검색 가능 PDF 저장">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Save Searchable PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Separator Background="{StaticResource GlassBorder}" Width="1" Height="20" Margin="6,0"/>

                    <Button x:Name="BtnBatchOcrSave"
                            Style="{StaticResource PrimaryButton}"
                            Padding="12,4" FontSize="12" Height="26"
                            Click="BtnBatchOcrSave_Click"
                            ToolTip="여러 PDF 파일을 선택하여 일괄 OCR 후 자동 저장">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📦" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="Batch OCR &amp; Save" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                </WrapPanel>
            </Border>

            <!-- ── Image viewer ── -->
            <ScrollViewer x:Name="ScrollMain"
                          Grid.Row="2"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="{StaticResource GlassHeader}"
                          Padding="12"
                          PreviewMouseWheel="PreviewArea_PreviewMouseWheel">
                <Grid x:Name="GridMainContent"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center">

                    <Border x:Name="OriginalDropZone"
                            Width="420" Height="290"
                            Background="{StaticResource GlassStrong}"
                            BorderBrush="{StaticResource GlassBorder}" BorderThickness="2"
                            CornerRadius="12">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F5BC;" FontSize="44"
                                       HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="Navigate to a PDF page in PDF Reader, then switch to OCR"
                                       FontSize="13" Foreground="#585B70"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="20,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Image + OCR overlay -->
                    <Grid x:Name="OcrContentGrid" Visibility="Collapsed">
                        <Image x:Name="ImgMain"
                               Stretch="None"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Canvas x:Name="OverlayCanvas"/>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ══════════════ OCR RESULTS PANEL ══════════════ -->
        <Border Grid.Column="2"
                Background="{StaticResource GlassStrong}"
                BorderBrush="{StaticResource GlassBorder}"
                BorderThickness="1,0,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Padding="12,10"
                        Background="{StaticResource GlassPanel}"
                        BorderBrush="{StaticResource GlassBorder}"
                        BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="OCR Results"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#CDD6F4"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="ResultCountBadge"
                                Background="{StaticResource GlassSurface}" CornerRadius="8"
                                Padding="6,2" Margin="8,0,0,0"
                                Visibility="Collapsed">
                            <TextBlock x:Name="TxtResultCount"
                                       FontSize="11" Foreground="#A6ADC8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="ResultsPanel" Margin="8,8,8,8">
                        <TextBlock x:Name="TxtNoResults"
                                   Text="OCR results will appear here."
                                   Foreground="#45475A" FontSize="12"
                                   TextWrapping="Wrap" Margin="4,4"/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</Page>
