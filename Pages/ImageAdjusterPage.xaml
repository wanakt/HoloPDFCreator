<Page x:Class="HoloPDFCreator.Pages.ImageAdjusterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E"
      Title="Image Adjuster">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#A6ADC8"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="Margin"      Value="0,12,0,4"/>
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground"  Value="#89B4FA"/>
            <Setter Property="FontSize"    Value="12"/>
            <Setter Property="FontWeight"  Value="SemiBold"/>
            <Setter Property="MinWidth"    Value="36"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ CONTROLS PANEL ══════════════ -->
        <Border Grid.Column="0"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16">
                <StackPanel>

                    <!-- Title -->
                    <TextBlock Text="Image Adjuster"
                               FontSize="18" FontWeight="Bold"
                               Foreground="#89B4FA"
                               Margin="0,8,0,20"/>

                    <!-- File Buttons -->
                    <Button Content="Open Image"
                            Style="{StaticResource PrimaryButton}"
                            Click="OpenImage_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"/>

                    <Button x:Name="BtnSaveImage"
                            Content="Save Result"
                            Style="{StaticResource SecondaryButton}"
                            Click="SaveImage_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,20"/>

                    <Rectangle Height="1" Fill="#313244" Margin="0,0,0,16"/>

                    <!-- ─── Brightness ─── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Brightness"/>
                        <TextBlock Grid.Column="1" x:Name="TxtBrightness" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldBrightness"
                            Minimum="-100" Maximum="100" Value="0"
                            ValueChanged="Slider_ValueChanged"
                            TickFrequency="10" IsSnapToTickEnabled="False"/>

                    <!-- ─── Contrast ─── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Contrast"/>
                        <TextBlock Grid.Column="1" x:Name="TxtContrast" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldContrast"
                            Minimum="-100" Maximum="100" Value="0"
                            ValueChanged="Slider_ValueChanged"
                            TickFrequency="10" IsSnapToTickEnabled="False"/>

                    <!-- ─── Stroke Thickness ─── -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Stroke Thickening"/>
                        <TextBlock Grid.Column="1" x:Name="TxtStroke" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldStroke"
                            Minimum="0" Maximum="5" Value="0"
                            ValueChanged="Slider_ValueChanged"
                            TickFrequency="1" IsSnapToTickEnabled="True"/>

                    <Rectangle Height="1" Fill="#313244" Margin="0,16,0,16"/>

                    <!-- ─── Auto Level ─── -->
                    <Button Content="Auto Level"
                            Style="{StaticResource PrimaryButton}"
                            Click="AutoLevel_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"/>

                    <Button Content="Reset All"
                            Style="{StaticResource SecondaryButton}"
                            Click="Reset_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"/>

                    <Rectangle Height="1" Fill="#313244" Margin="0,16,0,16"/>

                    <!-- ─── Apply ─── -->
                    <Button x:Name="BtnApply"
                            Content="Apply Changes"
                            Style="{StaticResource PrimaryButton}"
                            Click="Apply_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,8"/>

                    <!-- ─── Status ─── -->
                    <Border Background="#313244" CornerRadius="6" Padding="10,8" Margin="0,16,0,0">
                        <TextBlock x:Name="TxtStatus"
                                   Text="Open an image to begin"
                                   FontSize="11"
                                   Foreground="#A6ADC8"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <!-- ─── Image Info ─── -->
                    <TextBlock x:Name="TxtImageInfo"
                               Text=""
                               FontSize="11"
                               Foreground="#585B70"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════ PREVIEW AREA ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Preview Labels Toolbar -->
            <Border Grid.Row="0"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="0,0,0,1"
                    Padding="16,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Original"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#A6ADC8"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="1"
                               Text="Adjusted"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="#89B4FA"
                               HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Before / After Image Views -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Original -->
                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1E1E2E"
                              Padding="12">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="OriginalDropZone"
                                Width="360" Height="280"
                                Background="#181825"
                                BorderBrush="#313244"
                                BorderThickness="2"
                                CornerRadius="12"
                                AllowDrop="True"
                                Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F5BC;" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                <TextBlock Text="Drop image here" FontSize="14" Foreground="#585B70" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <Image x:Name="ImgOriginal"
                               Visibility="Collapsed"
                               Stretch="Uniform"
                               MaxWidth="2000" MaxHeight="4000"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </ScrollViewer>

                <!-- Divider -->
                <Border Grid.Column="1" Background="#313244"/>

                <!-- Adjusted -->
                <ScrollViewer Grid.Column="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1E1E2E"
                              Padding="12">
                    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="AdjustedPlaceholder"
                                Width="360" Height="280"
                                Background="#181825"
                                BorderBrush="#313244"
                                BorderThickness="2"
                                CornerRadius="12">
                            <TextBlock Text="Adjusted preview will appear here"
                                       FontSize="13"
                                       Foreground="#45475A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="ImgAdjusted"
                               Visibility="Collapsed"
                               Stretch="Uniform"
                               MaxWidth="2000" MaxHeight="4000"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
