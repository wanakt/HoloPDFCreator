<Page x:Class="HoloPDFCreator.Pages.ImageAdjusterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E"
      Title="Image Adjuster">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style x:Key="SliderLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A6ADC8"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Margin"     Value="0,10,0,3"/>
        </Style>
        <Style x:Key="SliderValue" TargetType="TextBlock">
            <Setter Property="Foreground"    Value="#89B4FA"/>
            <Setter Property="FontSize"      Value="12"/>
            <Setter Property="FontWeight"    Value="SemiBold"/>
            <Setter Property="MinWidth"      Value="36"/>
            <Setter Property="TextAlignment" Value="Right"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Foreground" Value="#89B4FA"/>
            <Setter Property="Margin"     Value="0,0,0,2"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="215"/>
            <ColumnDefinition Width="172"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════ CONTROLS PANEL ══════════════ -->
        <Border Grid.Column="0"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12">
                <StackPanel>

                    <TextBlock Text="Image Adjuster"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#89B4FA"
                               Margin="0,4,0,14"/>

                    <!-- Adjustments -->
                    <TextBlock Text="ADJUSTMENTS" FontSize="10" FontWeight="Bold"
                               Foreground="#45475A" Margin="0,0,0,2"
                               />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Brightness"/>
                        <TextBlock Grid.Column="1" x:Name="TxtBrightness" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldBrightness"
                            Minimum="-100" Maximum="100" Value="0"
                            ValueChanged="Slider_ValueChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Contrast"/>
                        <TextBlock Grid.Column="1" x:Name="TxtContrast" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldContrast"
                            Minimum="-100" Maximum="100" Value="0"
                            ValueChanged="Slider_ValueChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Stroke Thickening"/>
                        <TextBlock Grid.Column="1" x:Name="TxtStroke" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldStroke"
                            Minimum="0" Maximum="5" Value="0"
                            SmallChange="0.3" LargeChange="0.9"
                            TickFrequency="0.3" IsSnapToTickEnabled="True"
                            ValueChanged="Slider_ValueChanged"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource SliderLabel}" Text="Sharpen"/>
                        <TextBlock Grid.Column="1" x:Name="TxtSharpen" Style="{StaticResource SliderValue}" Text="0"/>
                    </Grid>
                    <Slider x:Name="SldSharpen"
                            Minimum="0" Maximum="5" Value="0"
                            SmallChange="0.3" LargeChange="0.9"
                            TickFrequency="0.3" IsSnapToTickEnabled="True"
                            ValueChanged="Slider_ValueChanged"/>

                    <!-- Auto Level checkbox -->
                    <Border Background="#252537" CornerRadius="6"
                            Padding="10,8" Margin="0,10,0,6">
                        <CheckBox x:Name="ChkAutoLevel"
                                  Content="Auto Level"
                                  Foreground="#CDD6F4"
                                  FontSize="12"
                                  Checked="AutoLevel_CheckChanged"
                                  Unchecked="AutoLevel_CheckChanged"
                                  ToolTip="Automatically stretch histogram to full range. Disables manual Brightness and Contrast."/>
                    </Border>

                    <Button Content="Reset All"
                            Style="{StaticResource SecondaryButton}"
                            Click="Reset_Click"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,0"/>

                    <Rectangle Height="1" Fill="#313244" Margin="0,14,0,12"/>

                    <!-- Apply -->
                    <TextBlock Text="APPLY" FontSize="10" FontWeight="Bold"
                               Foreground="#45475A" Margin="0,0,0,6"/>
                    <Button x:Name="BtnApplyAll"
                            Content="Apply to All"
                            Style="{StaticResource PrimaryButton}"
                            Click="ApplyAll_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,5"
                            ToolTip="Apply current settings to every page"/>
                    <Button x:Name="BtnApplyMarked"
                            Content="Apply to Marked"
                            Style="{StaticResource SecondaryButton}"
                            Click="ApplyMarked_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,14"
                            ToolTip="Apply to pages marked with Ctrl+click (or Shift+click for range) in the list"/>

                    <!-- Page range -->
                    <TextBlock Text="PAGE RANGE" FontSize="10" FontWeight="Bold"
                               Foreground="#45475A" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,5">
                        <TextBox x:Name="TxtPageRange"
                                 Background="#313244" Foreground="#CDD6F4"
                                 CaretBrush="#CDD6F4"
                                 BorderBrush="#45475A" BorderThickness="1"
                                 Padding="6,4" FontSize="11"
                                 TextChanged="TxtPageRange_TextChanged"/>
                        <TextBlock Text="e.g. 1–5, 7, 10–15"
                                   IsHitTestVisible="False"
                                   Foreground="#45475A" FontSize="11"
                                   Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=TxtPageRange}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button x:Name="BtnApplyRange"
                            Content="Apply to Range"
                            Style="{StaticResource SecondaryButton}"
                            Click="ApplyRange_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,14"/>

                    <Rectangle Height="1" Fill="#313244" Margin="0,0,0,12"/>

                    <!-- Save -->
                    <TextBlock Text="SAVE" FontSize="10" FontWeight="Bold"
                               Foreground="#45475A" Margin="0,0,0,6"
                               />
                    <Button x:Name="BtnSavePdf"
                            Content="Save as PDF…"
                            Style="{StaticResource PrimaryButton}"
                            Click="SaveAsPdf_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,5"
                            ToolTip="Overlay adjusted images onto the original PDF, preserving bookmarks and searchable text"/>
                    <Button x:Name="BtnSaveImage"
                            Content="Save Selected…"
                            Style="{StaticResource SecondaryButton}"
                            Click="SaveImage_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,5"/>
                    <Button x:Name="BtnSaveAll"
                            Content="Save All…"
                            Style="{StaticResource SecondaryButton}"
                            Click="SaveAll_Click"
                            IsEnabled="False"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,14"/>

                    <!-- Status -->
                    <Border Background="#313244" CornerRadius="6" Padding="10,8">
                        <TextBlock x:Name="TxtStatus"
                                   Text="Open images to begin"
                                   FontSize="11"
                                   Foreground="#A6ADC8"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock x:Name="TxtImageInfo"
                               Text=""
                               FontSize="10"
                               Foreground="#585B70"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ══════════════ IMAGE LIST PANEL ══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Border Grid.Row="0"
                    Background="#13131F"
                    BorderBrush="#313244"
                    BorderThickness="0,0,1,1"
                    Padding="8,7">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtImageCount"
                               Grid.Column="0"
                               Text="0 images"
                               FontSize="11" FontWeight="SemiBold"
                               Foreground="#89B4FA"
                               VerticalAlignment="Center"/>
                    <Button x:Name="BtnClearAll"
                            Grid.Column="1"
                            Content="Clear"
                            Click="ClearAll_Click"
                            IsEnabled="False"
                            Style="{StaticResource SecondaryButton}"
                            FontSize="10"
                            Padding="7,2"
                            Height="22"/>
                </Grid>
            </Border>

            <!-- Thumbnail list -->
            <Border Grid.Row="1" BorderBrush="#313244" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="#181825">
                    <StackPanel x:Name="ImageListPanel" Margin="5,5,5,5"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ══════════════ PREVIEW AREA ══════════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar: nav (left) + zoom (right) -->
            <Border Grid.Row="0"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="0,0,0,1"
                    Padding="8,6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation (Original side) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Original"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#A6ADC8"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="BtnPrev"
                                Content="◀"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnPrev_Click"
                                Width="26" Height="22"
                                Padding="0"
                                FontSize="9"
                                IsEnabled="False"/>
                        <TextBlock x:Name="TxtPageNav"
                                   Text="0 / 0"
                                   FontSize="11"
                                   Foreground="#89B4FA"
                                   VerticalAlignment="Center"
                                   Margin="6,0"
                                   MinWidth="42"
                                   TextAlignment="Center"/>
                        <Button x:Name="BtnNext"
                                Content="▶"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnNext_Click"
                                Width="26" Height="22"
                                Padding="0"
                                FontSize="9"
                                IsEnabled="False"/>
                    </StackPanel>

                    <!-- Zoom (Adjusted side) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Adjusted"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="#89B4FA"
                                   VerticalAlignment="Center"
                                   Margin="0,0,10,0"/>
                        <Button x:Name="BtnZoomOut"
                                Content="−"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnZoomOut_Click"
                                Width="26" Height="22"
                                Padding="0"
                                FontSize="14"/>
                        <TextBlock x:Name="TxtZoom"
                                   Text="100%"
                                   FontSize="11"
                                   Foreground="#A6ADC8"
                                   VerticalAlignment="Center"
                                   Margin="5,0"
                                   MinWidth="38"
                                   TextAlignment="Center"/>
                        <Button x:Name="BtnZoomIn"
                                Content="+"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnZoomIn_Click"
                                Width="26" Height="22"
                                Padding="0"
                                FontSize="14"/>
                        <Button x:Name="BtnZoomFit"
                                Content="Fit"
                                Style="{StaticResource SecondaryButton}"
                                Click="BtnZoomFit_Click"
                                Height="22"
                                Padding="7,0"
                                FontSize="11"
                                Margin="4,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Before / After -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Original -->
                <ScrollViewer x:Name="ScrollOriginal"
                              Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1E1E2E" Padding="12"
                              PreviewMouseWheel="PreviewArea_PreviewMouseWheel">
                    <Grid x:Name="GridOriginalContent"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="OriginalDropZone"
                                Width="300" Height="220"
                                Background="#181825"
                                BorderBrush="#313244" BorderThickness="2"
                                CornerRadius="12"
                                AllowDrop="True" Drop="DropZone_Drop">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#x1F5BC;" FontSize="38"
                                           HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                <TextBlock Text="Drop images, PDF or folder"
                                           FontSize="12" Foreground="#585B70"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap" Margin="20,0"/>
                            </StackPanel>
                        </Border>
                        <Image x:Name="ImgOriginal"
                               Visibility="Collapsed"
                               Stretch="Uniform"
                               MaxWidth="1400" MaxHeight="2000"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </ScrollViewer>

                <Border Grid.Column="1" Background="#313244"/>

                <!-- Adjusted -->
                <ScrollViewer x:Name="ScrollAdjusted"
                              Grid.Column="2"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto"
                              Background="#1E1E2E" Padding="12"
                              PreviewMouseWheel="PreviewArea_PreviewMouseWheel">
                    <Grid x:Name="GridAdjustedContent"
                          HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="AdjustedPlaceholder"
                                Width="300" Height="220"
                                Background="#181825"
                                BorderBrush="#313244" BorderThickness="2"
                                CornerRadius="12">
                            <TextBlock Text="Adjusted preview will appear here"
                                       FontSize="13" Foreground="#45475A"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <Image x:Name="ImgAdjusted"
                               Visibility="Collapsed"
                               Stretch="Uniform"
                               MaxWidth="1400" MaxHeight="2000"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Page>
