<Page x:Class="HoloPDFCreator.Pages.PDFReaderPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="#1E1E2E"
      Title="PDF Reader"
      PreviewKeyDown="Page_PreviewKeyDown">

    <Page.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#45475A"/>
            <Setter Property="Margin"     Value="4,0"/>
            <Setter Property="Width"      Value="1"/>
        </Style>
        <Style TargetType="ContextMenu">
            <Setter Property="Background"   Value="#2A2A3E"/>
            <Setter Property="BorderBrush"  Value="#45475A"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style TargetType="MenuItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#CDD6F4"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════════════ TOOLBAR ══════════════ -->
        <Border Grid.Row="0"
                Background="#181825"
                BorderBrush="#313244"
                BorderThickness="0,0,0,1"
                Padding="12,8">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- File Button + ContextMenu -->
                <Button x:Name="BtnFile"
                        Content="📁 File ▾"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,10"
                        FontSize="15"
                        Click="BtnFile_Click"
                        Margin="0,0,12,0">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="FileContextMenu"
                                     Placement="Bottom">
                            <ContextMenu.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#252538"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"      Color="#CDD6F4"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#45475A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#CDD6F4"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}"      Color="#585B70"/>
                            </ContextMenu.Resources>
                            <MenuItem Header="Open PDF…"    Click="OpenPdf_Click"/>
                            <MenuItem Header="Open Images…" Click="OpenImages_Click"/>
                            <Separator/>
                            <MenuItem x:Name="MenuItemSave"
                                      Header="Save"
                                      IsEnabled="False"
                                      Click="MenuSave_Click"/>
                            <MenuItem x:Name="MenuItemSaveAs"
                                      Header="Save As…"
                                      IsEnabled="False"
                                      Click="MenuSaveAs_Click"/>
                            <Separator x:Name="RecentFilesSeparator" Visibility="Collapsed"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <!-- View Button + ContextMenu -->
                <Button x:Name="BtnView"
                        Content="🗗 View ▾"
                        Style="{StaticResource SecondaryButton}"
                        Padding="18,10"
                        FontSize="15"
                        Click="BtnView_Click"
                        Margin="0,0,12,0">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ViewContextMenu">
                            <ContextMenu.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}"          Color="#252538"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}"      Color="#CDD6F4"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}"     Color="#45475A"/>
                                <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#CDD6F4"/>
                            </ContextMenu.Resources>
                            <MenuItem x:Name="MenuViewBookmarks"
                                      Header="Bookmarks"
                                      IsCheckable="True" IsChecked="False"
                                      Click="MenuViewBookmarks_Click"/>
                            <MenuItem x:Name="MenuViewPages"
                                      Header="Pages"
                                      IsCheckable="True" IsChecked="False"
                                      Click="MenuViewPages_Click"/>
                            <MenuItem x:Name="MenuViewAdjust"
                                      Header="Image Adjust"
                                      IsCheckable="True" IsChecked="False"
                                      Click="MenuViewAdjust_Click"/>
                            <MenuItem x:Name="MenuViewSearch"
                                      Header="Search"
                                      IsCheckable="True" IsChecked="False"
                                      Click="MenuViewSearch_Click"/>
                            <MenuItem x:Name="MenuViewCrop"
                                      Header="Crop"
                                      IsCheckable="True" IsChecked="False"
                                      Click="MenuViewCrop_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <Separator/>

                <!-- Page Navigation -->
                <Button Content="&#x25C4;"
                        x:Name="BtnPrev"
                        Style="{StaticResource SecondaryButton}"
                        Click="PrevPage_Click"
                        IsEnabled="False"
                        Margin="6,0,4,0"
                        Padding="10,7"/>

                <Border Background="#313244" CornerRadius="6" Padding="12,6" Margin="2,0">
                    <TextBlock x:Name="TxtPageInfo"
                               Text="No document"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Border>

                <Button Content="&#x25BA;"
                        x:Name="BtnNext"
                        Style="{StaticResource SecondaryButton}"
                        Click="NextPage_Click"
                        IsEnabled="False"
                        Margin="4,0,12,0"
                        Padding="10,7"/>

                <Separator/>

                <!-- Zoom -->
                <Button Content="&#x2212;"
                        Style="{StaticResource SecondaryButton}"
                        Click="ZoomOut_Click"
                        Margin="6,0,4,0"
                        Padding="10,7"/>

                <Border Background="#313244" CornerRadius="6" Padding="10,6" Margin="2,0">
                    <TextBlock x:Name="TxtZoom"
                               Text="100%"
                               FontSize="13"
                               VerticalAlignment="Center"/>
                </Border>

                <Button Content="&#x2B;"
                        Style="{StaticResource SecondaryButton}"
                        Click="ZoomIn_Click"
                        Margin="4,0,4,0"
                        Padding="10,7"/>

                <Button Content="Fit"
                        Style="{StaticResource SecondaryButton}"
                        Click="ZoomFit_Click"
                        Margin="4,0,0,0"/>

                <Separator/>

                <!-- Drawing Tools -->
                <Button x:Name="BtnDrawLine"
                        Style="{StaticResource SecondaryButton}"
                        Click="DrawTool_Click" Tag="Line"
                        Padding="10,8"
                        Margin="6,0,4,0">
                    <Button.ToolTip>
                        <ToolTip Content="Line (Shift: horizontal/vertical)"/>
                    </Button.ToolTip>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Line X1="3" Y1="21" X2="21" Y2="3"
                                  Stroke="#CDD6F4" StrokeThickness="2.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="BtnDrawBox"
                        Style="{StaticResource SecondaryButton}"
                        Click="DrawTool_Click" Tag="Box"
                        Padding="10,8"
                        Margin="0,0,4,0">
                    <Button.ToolTip>
                        <ToolTip Content="Box (Shift: square)"/>
                    </Button.ToolTip>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Rectangle Canvas.Left="3" Canvas.Top="3"
                                       Width="18" Height="18"
                                       Stroke="#CDD6F4" StrokeThickness="2.5"
                                       Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button x:Name="BtnDrawCircle"
                        Style="{StaticResource SecondaryButton}"
                        Click="DrawTool_Click" Tag="Circle"
                        Padding="10,8"
                        Margin="0,0,4,0">
                    <Button.ToolTip>
                        <ToolTip Content="Circle (Shift: perfect circle)"/>
                    </Button.ToolTip>
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <Ellipse Canvas.Left="3" Canvas.Top="3"
                                     Width="18" Height="18"
                                     Stroke="#CDD6F4" StrokeThickness="2.5"
                                     Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Memos Toggle (icon) — placed right after Circle -->
                <Button x:Name="BtnToggleMemos"
                        Style="{StaticResource SecondaryButton}"
                        Click="ToggleMemos_Click"
                        Padding="10,8"
                        Margin="0,0,4,0"
                        ToolTip="Memos">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <!-- Note body -->
                            <Rectangle Canvas.Left="3" Canvas.Top="2"
                                       Width="16" Height="20"
                                       Stroke="#CDD6F4" StrokeThickness="1.8"
                                       Fill="Transparent" RadiusX="2" RadiusY="2"/>
                            <!-- Lines representing text -->
                            <Line X1="6" Y1="8"  X2="18" Y2="8"
                                  Stroke="#CDD6F4" StrokeThickness="1.5"/>
                            <Line X1="6" Y1="12" X2="18" Y2="12"
                                  Stroke="#CDD6F4" StrokeThickness="1.5"/>
                            <Line X1="6" Y1="16" X2="14" Y2="16"
                                  Stroke="#CDD6F4" StrokeThickness="1.5"/>
                            <!-- Folded corner -->
                            <Polyline Points="15,2 19,6 15,6 15,2"
                                      Stroke="#CDD6F4" StrokeThickness="1.4"
                                      Fill="#313244"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <!-- Highlight — applies yellow highlight to selected searchable text -->
                <Button x:Name="BtnHighlight"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnHighlight_Click"
                        Padding="10,8"
                        Margin="0,0,0,0"
                        IsEnabled="False"
                        ToolTip="Highlight selected text (yellow)">
                    <Viewbox Width="18" Height="18">
                        <Canvas Width="24" Height="24">
                            <!-- Yellow highlight bar -->
                            <Rectangle Canvas.Left="2" Canvas.Top="15"
                                       Width="20" Height="6"
                                       Fill="#FFEE00" RadiusX="1" RadiusY="1"/>
                            <!-- "A" letter above it -->
                            <Path Fill="#CDD6F4"
                                  Data="M12,3 L17,14 H15 L13.5,10.5 H10.5 L9,14 H7 Z
                                        M12,6.5 L13,9.5 H11 Z"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Separator/>

                <!-- Rotate -->
                <Button x:Name="BtnRotate"
                        Content="Rotate"
                        Style="{StaticResource SecondaryButton}"
                        Click="RotatePage_Click"
                        IsEnabled="False"
                        Margin="6,0,0,0"/>

                <!-- TxtStatus kept hidden so code-behind references compile -->
                <TextBlock x:Name="TxtStatus" Visibility="Collapsed"/>
            </WrapPanel>
        </Border>

        <!-- ══════════════ MAIN CONTENT ══════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="MemoPanelCol"    Width="0"/>
                <ColumnDefinition x:Name="AdjustPanelCol"  Width="0"/>
                <ColumnDefinition x:Name="SearchPanelCol"  Width="0"/>
                <ColumnDefinition x:Name="CropPanelCol"    Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="BookmarkPanelCol"  Width="0"/>
                    <ColumnDefinition x:Name="PagesPanelCol"     Width="0" MinWidth="0"/>
                    <ColumnDefinition x:Name="PagesSplitterCol"  Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ══════════════ BOOKMARK PANEL ══════════════ -->
                <Border Grid.Column="0"
                        Background="#181825"
                        BorderBrush="#313244"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#13131F"
                                BorderBrush="#313244"
                                BorderThickness="0,0,0,1"
                                Padding="8,4,4,4">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bookmarks"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#89B4FA"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="✕" FontSize="10"
                                        Padding="4,2"
                                        ToolTip="Hide Bookmarks"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnHideBookmarks_Click"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="BookmarkScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#181825">
                            <StackPanel x:Name="BookmarkPanel" Background="Transparent" Margin="4,4,4,4"/>
                        </ScrollViewer>
                        <!-- Drag overlay: sits above ScrollViewer, captures mouse during bookmark drag -->
                        <Canvas x:Name="BmDragOverlay"
                                Grid.Row="1"
                                Background="Transparent"
                                IsHitTestVisible="False"/>
                    </Grid>
                </Border>

                <!-- ══════════════ THUMBNAIL PANEL ══════════════ -->
                <Border Grid.Column="1"
                        Background="#181825"
                        BorderBrush="#313244"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0"
                                Background="#13131F"
                                BorderBrush="#313244"
                                BorderThickness="0,0,0,1"
                                Padding="8,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Pages"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="#89B4FA"
                                           VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Content="✕" FontSize="10"
                                        Padding="4,2"
                                        ToolTip="Hide Pages"
                                        Style="{StaticResource SecondaryButton}"
                                        Click="BtnHidePages_Click"/>
                            </Grid>
                        </Border>
                        <ScrollViewer x:Name="ThumbScrollViewer"
                                      Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Background="#181825"
                                      AllowDrop="True">
                            <WrapPanel x:Name="ThumbPanel" Orientation="Horizontal" Margin="4,4,4,4">
                                <TextBlock Text="Open a PDF to see pages"
                                           FontSize="10" Foreground="#45475A"
                                           TextWrapping="Wrap" Margin="4,8"/>
                            </WrapPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <GridSplitter Grid.Column="2"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              Background="#2A2A3E"
                              Cursor="SizeWE"/>

                <ScrollViewer x:Name="PdfScrollViewer"
                              Grid.Column="3"
                              Background="#1E1E2E"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Hidden"
                              Padding="20"
                              PreviewMouseWheel="PdfScrollViewer_PreviewMouseWheel"
                              ScrollChanged="PdfScrollViewer_ScrollChanged">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">

                    <!-- Drop zone -->
                    <Border x:Name="DropZone"
                            Width="600" Height="400"
                            Background="#181825"
                            BorderBrush="#313244"
                            BorderThickness="2"
                            CornerRadius="16"
                            AllowDrop="True"
                            Drop="DropZone_Drop">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="&#x1F4C4;"
                                       FontSize="64"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,16"/>
                            <TextBlock Text="Drop a PDF here or click Open"
                                       FontSize="18"
                                       Foreground="#585B70"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="Supports .pdf files"
                                       FontSize="13"
                                       Foreground="#45475A"
                                       HorizontalAlignment="Center"
                                       Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Previous page previews (dynamic count fills viewport) -->
                    <StackPanel x:Name="PrevPagesPanel"/>

                    <!-- PDF Page Display -->
                    <Border x:Name="PdfPageBorder"
                            Visibility="Collapsed"
                            Background="White">
                        <Grid>
                            <Image x:Name="PdfPageImage"
                                   Stretch="None"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <Canvas x:Name="AnnotationCanvas"
                                    IsHitTestVisible="False"
                                    Background="Transparent"/>

                            <Canvas x:Name="MemoCanvas"
                                    IsHitTestVisible="False"
                                    Background="Transparent"/>

                            <Canvas x:Name="DrawingCanvas"
                                    Background="Transparent"
                                    IsHitTestVisible="False"/>

                            <Canvas x:Name="TextOverlayCanvas"
                                    Background="Transparent"
                                    Cursor="Arrow"
                                    Focusable="True"
                                    KeyDown="TextOverlayCanvas_KeyDown"
                                    MouseLeftButtonDown="TextOverlayCanvas_MouseDown"
                                    MouseMove="TextOverlayCanvas_MouseMove"
                                    MouseLeftButtonUp="TextOverlayCanvas_MouseUp"
                                    MouseLeave="TextOverlayCanvas_MouseLeave"
                                    ContextMenuOpening="TextOverlayCanvas_ContextMenuOpening">
                                <Canvas.ContextMenu>
                                    <ContextMenu/>
                                </Canvas.ContextMenu>
                            </Canvas>

                            <Canvas x:Name="CropCanvas"
                                    IsHitTestVisible="False"
                                    Background="Transparent"/>
                        </Grid>
                    </Border>

                    <!-- Next page previews (dynamic count fills viewport) -->
                    <StackPanel x:Name="NextPagesPanel"/>

                </StackPanel>
                </ScrollViewer>

                <ScrollBar x:Name="GlobalScrollBar"
                           Grid.Column="4"
                           Orientation="Vertical"
                           Minimum="0"
                           Maximum="1"
                           Value="0"
                           ViewportSize="1"
                           IsEnabled="False"
                           Scroll="GlobalScrollBar_Scroll"/>
            </Grid>

            <!-- ══════════════ ADJUST PANEL ══════════════ -->
            <Border Grid.Column="2"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0"
                            Background="#13131F"
                            BorderBrush="#313244"
                            BorderThickness="0,0,0,1"
                            Padding="12,4,4,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Image Adjust"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#89B4FA"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="✕" FontSize="10"
                                    Padding="4,2"
                                    ToolTip="Hide Image Adjust"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnHideAdjust_Click"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="12,10,12,12">

                        <!-- Auto Level -->
                        <CheckBox x:Name="ChkAutoLevel"
                                  Content="Auto Level"
                                  FontSize="12" Foreground="#CDD6F4"
                                  Checked="AdjAutoLevel_Changed"
                                  Unchecked="AdjAutoLevel_Changed"
                                  Margin="0,0,0,8"/>

                        <Rectangle Height="1" Fill="#45475A" Margin="0,0,0,8"/>

                        <!-- Brightness -->
                        <TextBlock Text="Brightness" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderBrightness" Grid.Column="0"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" IsSnapToTickEnabled="False"
                                    ValueChanged="AdjSlider_ValueChanged"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblBrightness" Grid.Column="1"
                                       Text="0" FontSize="11" Foreground="#89B4FA"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>

                        <!-- Contrast -->
                        <TextBlock Text="Contrast" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderContrast" Grid.Column="0"
                                    Minimum="-100" Maximum="100" Value="0"
                                    TickFrequency="10" IsSnapToTickEnabled="False"
                                    ValueChanged="AdjSlider_ValueChanged"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblContrast" Grid.Column="1"
                                       Text="0" FontSize="11" Foreground="#89B4FA"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>

                        <!-- Stroke -->
                        <TextBlock Text="Thicken Strokes" FontSize="11" Foreground="#A6ADC8" Margin="0,0,0,2"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="36"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SliderStroke" Grid.Column="0"
                                    Minimum="0" Maximum="2" Value="0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    ValueChanged="AdjSlider_ValueChanged"
                                    VerticalAlignment="Center"/>
                            <TextBlock x:Name="LblStroke" Grid.Column="1"
                                       Text="0.0" FontSize="11" Foreground="#89B4FA"
                                       VerticalAlignment="Center" TextAlignment="Right"/>
                        </Grid>

                        <Rectangle Height="1" Fill="#45475A" Margin="0,0,0,8"/>

                        <!-- Unsharp Mask box -->
                        <Border BorderBrush="#45475A" BorderThickness="1"
                                CornerRadius="4" Padding="8,6,8,6" Margin="0,0,0,8">
                            <StackPanel>
                                <TextBlock Text="Unsharp Mask" FontSize="11" FontWeight="SemiBold"
                                           Foreground="#A6ADC8" Margin="0,0,0,6"/>
                                <TextBlock Text="Amount" FontSize="10" Foreground="#7C7F93" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderUsmAmount" Grid.Column="0"
                                            Minimum="0" Maximum="3" Value="0"
                                            TickFrequency="0.1" IsSnapToTickEnabled="False"
                                            ValueChanged="AdjSlider_ValueChanged"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblUsmAmount" Grid.Column="1"
                                               Text="0.0" FontSize="11" Foreground="#89B4FA"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="Radius" FontSize="10" Foreground="#7C7F93" Margin="0,0,0,2"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderUsmRadius" Grid.Column="0"
                                            Minimum="1" Maximum="10" Value="1"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="AdjSlider_ValueChanged"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblUsmRadius" Grid.Column="1"
                                               Text="1" FontSize="11" Foreground="#89B4FA"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                                <TextBlock Text="Threshold" FontSize="10" Foreground="#7C7F93" Margin="0,0,0,2"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="SliderUsmThreshold" Grid.Column="0"
                                            Minimum="0" Maximum="30" Value="0"
                                            TickFrequency="1" IsSnapToTickEnabled="True"
                                            ValueChanged="AdjSlider_ValueChanged"
                                            VerticalAlignment="Center"/>
                                    <TextBlock x:Name="LblUsmThreshold" Grid.Column="1"
                                               Text="0" FontSize="11" Foreground="#89B4FA"
                                               VerticalAlignment="Center" TextAlignment="Right"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Reset -->
                        <Button Content="Reset"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="11" Padding="8,4" Height="24"
                                Click="AdjReset_Click"
                                Margin="0,0,0,12"/>

                        <Rectangle Height="1" Fill="#313244" Margin="0,0,0,12"/>

                        <!-- Apply buttons -->
                        <Button x:Name="BtnAdjApplyAll"
                                Content="Apply to All Pages"
                                Style="{StaticResource SecondaryButton}"
                                FontSize="12" Padding="8,6"
                                IsEnabled="False"
                                Click="AdjApplyAll_Click"
                                Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="6"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnAdjApplyOdd"
                                    Grid.Column="0"
                                    Content="Apply Odd"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="4,5"
                                    IsEnabled="{Binding IsEnabled, ElementName=BtnAdjApplyAll}"
                                    Click="AdjApplyOdd_Click"/>
                            <Button x:Name="BtnAdjApplyEven"
                                    Grid.Column="2"
                                    Content="Apply Even"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="4,5"
                                    IsEnabled="{Binding IsEnabled, ElementName=BtnAdjApplyAll}"
                                    Click="AdjApplyEven_Click"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtAdjRange"
                                     Grid.Column="0"
                                     Text="1"
                                     FontSize="12"
                                     Padding="6,4"
                                     ToolTip="e.g. 1-3,5,7-9"/>
                            <Button Grid.Column="2"
                                    Content="Apply Range"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Padding="8,4"
                                    IsEnabled="{Binding IsEnabled, ElementName=BtnAdjApplyAll}"
                                    Click="AdjApplyRange_Click"/>
                        </Grid>

                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════ SEARCH PANEL ══════════════ -->
            <Border Grid.Column="3"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="#13131F"
                            BorderBrush="#313244"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Search"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#89B4FA"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="✕" FontSize="10"
                                    Padding="4,2"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Hide Search"
                                    Click="BtnHideSearch_Click"/>
                        </Grid>
                    </Border>

                    <!-- Input area -->
                    <Border Grid.Row="1"
                            Background="#1E1E2E"
                            BorderBrush="#313244"
                            BorderThickness="0,0,0,1"
                            Padding="8,8">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtSearchBox"
                                         Grid.Column="0"
                                         Background="#313244"
                                         Foreground="#CDD6F4"
                                         CaretBrush="#CDD6F4"
                                         BorderBrush="#45475A"
                                         BorderThickness="1"
                                         Padding="6,5"
                                         FontSize="12"
                                         KeyDown="TxtSearch_KeyDown"/>
                                <Button x:Name="BtnSearch"
                                        Grid.Column="1"
                                        Content="▶"
                                        Width="28" Height="28"
                                        Margin="4,0,0,0"
                                        Style="{StaticResource PrimaryButton}"
                                        FontSize="10"
                                        Padding="0"
                                        Click="BtnSearch_Click"/>
                            </Grid>
                            <CheckBox x:Name="ChkSearchWithin"
                                      Content="결과 내 재검색"
                                      FontSize="11"
                                      Foreground="#A6ADC8"
                                      Margin="0,0,0,4"/>
                            <TextBlock x:Name="TxtSearchStatus"
                                       Text=""
                                       FontSize="10"
                                       Foreground="#585B70"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Results list -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Background="#181825">
                        <StackPanel x:Name="SearchResultsPanel" Margin="4,4,4,8"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════ CROP PANEL ══════════════ -->
            <Border Grid.Column="4"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="#13131F"
                            BorderBrush="#313244"
                            BorderThickness="0,0,0,1"
                            Padding="10,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Crop"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#89B4FA"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="1"
                                    Content="✕" FontSize="10"
                                    Padding="4,2"
                                    Style="{StaticResource SecondaryButton}"
                                    ToolTip="Hide Crop"
                                    Click="BtnHideCrop_Click"/>
                        </Grid>
                    </Border>

                    <!-- Content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="12,12,12,12">

                            <TextBlock Text="Crop (pt)"
                                       FontSize="12" FontWeight="SemiBold"
                                       Foreground="#89B4FA" Margin="0,0,0,10"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Top" FontSize="11"
                                           Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCropTop" Grid.Column="1"
                                         Text="0" FontSize="12" Padding="6,4"
                                         TextChanged="CropInput_Changed"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Bottom" FontSize="11"
                                           Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCropBottom" Grid.Column="1"
                                         Text="0" FontSize="12" Padding="6,4"
                                         TextChanged="CropInput_Changed"/>
                            </Grid>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Left" FontSize="11"
                                           Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCropLeft" Grid.Column="1"
                                         Text="0" FontSize="12" Padding="6,4"
                                         TextChanged="CropInput_Changed"/>
                            </Grid>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="54"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Right" FontSize="11"
                                           Foreground="#A6ADC8" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtCropRight" Grid.Column="1"
                                         Text="0" FontSize="12" Padding="6,4"
                                         TextChanged="CropInput_Changed"/>
                            </Grid>

                            <Button x:Name="BtnCropApplyPage"
                                    Content="Crop This Page"
                                    Style="{StaticResource PrimaryButton}"
                                    FontSize="12" Padding="8,6"
                                    IsEnabled="False"
                                    Click="BtnCropApplyPage_Click"
                                    Margin="0,0,0,6"/>

                            <Button x:Name="BtnCropApplyAll"
                                    Content="Crop All Pages"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="12" Padding="8,6"
                                    IsEnabled="False"
                                    Click="BtnCropApplyAll_Click"
                                    Margin="0,0,0,6"/>

                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnCropApplyOdd"
                                        Grid.Column="0"
                                        Content="Crop Odd"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="11" Padding="4,5"
                                        IsEnabled="{Binding IsEnabled, ElementName=BtnCropApplyAll}"
                                        Click="BtnCropApplyOdd_Click"/>
                                <Button x:Name="BtnCropApplyEven"
                                        Grid.Column="2"
                                        Content="Crop Even"
                                        Style="{StaticResource SecondaryButton}"
                                        FontSize="11" Padding="4,5"
                                        IsEnabled="{Binding IsEnabled, ElementName=BtnCropApplyAll}"
                                        Click="BtnCropApplyEven_Click"/>
                            </Grid>

                            <Button x:Name="BtnCropReset"
                                    Content="Reset Crop"
                                    Style="{StaticResource SecondaryButton}"
                                    FontSize="11" Padding="8,4" Height="24"
                                    IsEnabled="{Binding IsEnabled, ElementName=BtnCropApplyAll}"
                                    Click="BtnCropReset_Click"/>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ══════════════ MEMO PANEL ══════════════ -->
            <Border Grid.Column="1"
                    Background="#181825"
                    BorderBrush="#313244"
                    BorderThickness="1,0,0,0"
                    ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Header + Search -->
                    <Border Grid.Row="0"
                            Padding="10,8"
                            Background="#1E1E2E"
                            BorderBrush="#313244"
                            BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Memos"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       Foreground="#CDD6F4"
                                       Margin="0,0,0,6"/>
                            <Grid>
                                <TextBox x:Name="MemoSearchBox"
                                         TextChanged="MemoSearch_TextChanged"/>
                                <TextBlock Text="Search…"
                                           IsHitTestVisible="False"
                                           Foreground="#585B70"
                                           FontSize="13"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=MemoSearchBox}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Memo List -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="MemoListPanel" Background="Transparent"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
